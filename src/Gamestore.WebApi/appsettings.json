{
  "ConnectionStrings": {
    "GamestoreDatabase": "",
    "NorthwindDatabase": ""
  },

  "CacheSettings": {
    "ExpirationInMinutes": 1,
    "OutputCacheExpirationInMinutes": 1
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ],
    "AllowedHeaders": [ "*" ],
    "AllowedMethods": [ "*" ],
    "ExposedHeaders": [ "x-total-numbers-of-games" ]
  },

  "JwtSettings": {
    "Key": "",
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryInMinutes": 30
  },

  "AzureBlobStorage": {
    "ConnectionString": "",
    "GameContainerName": "game-images"
  },

  "ExternalAuthApi": {
    "BaseUrl": "https://localhost:5037/api/"
  },

  "PaymentApi": {
    "BaseUrl": "http://localhost:5000/api/",
    "RetrySettings": {
      "MaxRetries": 3,
      "DelayInMilliseconds": 2000
    }
  },

  "BankPaymentSettings": {
    "ValidityPeriodInDays": 7
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[Timestamp]: {Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}{NewLine}[Category]: {SourceContext}{NewLine}[Level]: {Level}{NewLine}[Message]: {Message:lj}{NewLine}{Exception}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/general-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "[Timestamp]: {Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}{NewLine}[Category]: {SourceContext}{NewLine}[Level]: {Level}{NewLine}[Message]: {Message:lj}{NewLine}{Exception}{NewLine}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/exceptions-.txt",
          "restrictedToMinimumLevel": "Error",
          "rollingInterval": "Day",
          "outputTemplate": "[Timestamp]: {Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}{NewLine}[Category]: {SourceContext}{NewLine}[Level]: {Level}{NewLine}[Message]: {Message:lj}{NewLine}{Exception}{NewLine}"
        }
      }
    ]
  },

  "AllowedHosts": "*"
}
